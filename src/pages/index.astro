---
import '../styles/global.css';
import {
  links, seo, hero, conceito, paraQuem, historia, numeros, marcos,
  temas, ecossistema, canais, comunidade, rarm, final,
} from '../data/site';

// Link "pronto" = endereço real (começa com http). Enquanto estiver PENDENTE ('#...'),
// o botão some ou vira "Em breve", para ninguém clicar num link quebrado.
const pronto = (url: string) => url.startsWith('http');
const newsletterPronta = pronto(links.newsletter);
const grupoPronto = pronto(links.whatsappGrupo);
const ogImagem = new URL('/img/og.jpg', Astro.site).href;
const urlCanonica = new URL('/', Astro.site).href;
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.titulo}</title>
    <meta name="description" content={seo.descricao} />
    <meta name="theme-color" content="#0f0f0f" />
    <meta property="og:title" content={seo.titulo} />
    <meta property="og:description" content={seo.descricao} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=MuseoModerno:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- 1. Promessa (gatilhos: antecipação e novidade) -->
    <div class="escuro hero-fundo">
      <header class="topo container">
        <a href="#" class="marca">gabriel<span class="ponto">.</span>da luz</a>
        {newsletterPronta
          ? <a class="link" href={links.newsletter} target="_blank" rel="noopener">Newsletter</a>
          : <a class="link" href={links.youtube} target="_blank" rel="noopener">YouTube</a>}
      </header>
      <section class="hero">
        <div class="container hero-grade">
          <div class="hero-texto">
            <div class="perfil">
              <img class="avatar" src="/img/gabriel-perfil.jpg" width="240" height="240" alt={hero.fotoAlt} fetchpriority="high" />
              <span class="selo">{hero.selo}</span>
            </div>
            <h1>
              <span class="verde-claro">{hero.titulo[0]}</span>
              {' '}{hero.titulo[1]} {hero.titulo[2]}
            </h1>
            <p class="sub">{hero.subtitulo}</p>
            <p class="gratis">{hero.gratis}</p>
            <div class="acoes">
              {newsletterPronta ? (
                <>
                  <a class="botao verde-fundo" href={links.newsletter} target="_blank" rel="noopener">{hero.cta}</a>
                  <a class="link" href={links.youtube} target="_blank" rel="noopener">{hero.ctaSecundario}</a>
                </>
              ) : (
                <a class="botao verde-fundo" href={links.youtube} target="_blank" rel="noopener">{hero.ctaSecundario}</a>
              )}
            </div>
          </div>
        </div>
      </section>
    </div>

    <main>
      <!-- 2. O conceito (gatilho: novidade, uma ideia nova com nome) -->
      <section>
        <div class="container">
          <span class="selo escuro-texto">{conceito.selo}</span>
          <h2>{conceito.titulo}</h2>
          <p class="intro">{conceito.texto}</p>
          <ol class="pilares">
            {conceito.itens.map((i) => (
              <li>
                <span class="num">{i.numero}</span>
                <h3>{i.nome}</h3>
                <p>{i.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 3. Para quem é (gatilhos: identificação e dor) -->
      <section class="suave">
        <div class="container">
          <h2>{paraQuem.titulo}</h2>
          <p class="intro">{paraQuem.intro}</p>
          <div class="segmentos">
            {paraQuem.itens.map((s) => (
              <div class="segmento"><h3>{s.nome}</h3><p>{s.texto}</p></div>
            ))}
          </div>
          <p class="fecho">{paraQuem.fecho}</p>
        </div>
      </section>

      <!-- 4. História (gatilho: história e jornada) -->
      <section class="escuro">
        <div class="container historia-grade">
          <img class="foto-historia" src="/img/gabriel-bastidor.jpg" width="720" height="720" alt={historia.fotoAlt} loading="lazy" />
          <div>
            <h2>{historia.titulo}</h2>
            <div class="texto">
              {historia.paragrafos.map((p) => <p>{p}</p>)}
            </div>
            <blockquote>“{historia.frase}”</blockquote>
          </div>
        </div>
      </section>

      <!-- 5. Autoridade e prova (gatilhos: autoridade e prova social) -->
      <section>
        <div class="container">
          <div class="numeros">
            {numeros.map((n) => (
              <div class="numero">
                <strong>{n.valor}</strong>
                <span>{n.legenda}</span>
              </div>
            ))}
          </div>
          {marcos.length > 0 && (
            <ol class="marcos">
              {marcos.map((m) => <li><span>{m.ano}</span>{m.texto}</li>)}
            </ol>
          )}
        </div>
      </section>

      <!-- 6. Temas (gatilho: reciprocidade, o que você ganha) -->
      <section class="borda-topo">
        <div class="container">
          <h2>{temas.titulo}</h2>
          <div class="temas">
            {temas.itens.map((t) => (
              <div class="tema"><h3>{t.nome}</h3><p>{t.texto}</p></div>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. Ecossistema (gatilho: prova social) -->
      <section class="suave">
        <div class="container eco-grade">
          <div>
            <h2>{ecossistema.titulo}</h2>
            <p class="intro">{ecossistema.texto}</p>
          </div>
          <img class="foto-eco" src="/img/gabriel-ecossistema.jpg" width="720" height="900" alt={ecossistema.fotoAlt} loading="lazy" />
        </div>
      </section>

      <!-- 8. Canais (gatilho: comunidade) -->
      <section>
        <div class="container">
          <h2>{canais.titulo}</h2>
          <div class="canais">
            {canais.itens.map((c) => {
              const url = links[c.chave as keyof typeof links];
              return pronto(url) ? (
                <a class="canal" href={url} target="_blank" rel="noopener">
                  <span class="canal-nome">{c.nome}</span>
                  <h3>{c.destaque}</h3>
                  <p>{c.texto}</p>
                  <span class="link">{c.cta} →</span>
                </a>
              ) : (
                <div class="canal em-breve">
                  <span class="canal-nome">{c.nome}</span>
                  <h3>{c.destaque}</h3>
                  <p>{c.texto}</p>
                  <span class="breve">Em breve</span>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- 9. Comunidade (gatilhos: exclusividade e escassez) -->
      <section id="comunidade" class="escuro">
        <div class="container comunidade">
          <div>
            <span class="selo">{comunidade.selo}</span>
            <h2>{comunidade.titulo}</h2>
            <p>{comunidade.texto}</p>
          </div>
          {grupoPronto
            ? <a class="botao verde-fundo" href={links.whatsappGrupo} target="_blank" rel="noopener">{comunidade.cta}</a>
            : <span class="breve claro">Em breve</span>}
        </div>
      </section>

      <!-- 10. RARM (captação de lead, com UTM "Perfil Gabriel") -->
      <section>
        <div class="container rarm">
          <div>
            <span class="selo escuro-texto">RARM Contabilidade</span>
            <h2>{rarm.titulo}</h2>
            <p>{rarm.texto}</p>
          </div>
          <a class="botao" href={links.rarm} target="_blank" rel="noopener">{rarm.cta}</a>
        </div>
      </section>

      <!-- 11. Newsletter no final (gatilho: chamada única e clara) -->
      <section id="newsletter" class="escuro">
        <div class="container final">
          <h2>{final.titulo}</h2>
          <p>{final.texto}</p>
          {links.newsletterEmbed ? (
            <iframe src={links.newsletterEmbed} width="480" height="150" title="Assinar a newsletter no Substack" loading="lazy" style="border:0;background:transparent;max-width:100%"></iframe>
          ) : (
            newsletterPronta
              ? <a class="botao verde-fundo" href={links.newsletter} target="_blank" rel="noopener">{final.cta}</a>
              : <a class="botao verde-fundo" href={links.youtube} target="_blank" rel="noopener">Enquanto isso, veja os vídeos</a>
          )}
          <p class="assinatura">{final.assinatura}</p>
        </div>
      </section>
    </main>

    <footer class="container rodape">
      <span>© {new Date().getFullYear()} Gabriel da Luz · Curitiba/PR</span>
      <nav>
        <a href={links.youtube} target="_blank" rel="noopener">YouTube</a>
        <a href={links.instagram} target="_blank" rel="noopener">Instagram</a>
        {pronto(links.linkedin) && <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        {pronto(links.tiktok) && <a href={links.tiktok} target="_blank" rel="noopener">TikTok</a>}
        <a href={links.rarm} target="_blank" rel="noopener">RARM</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  .hero-fundo { background: #000; }
  .topo { display: flex; justify-content: space-between; align-items: center; padding-top: 28px; padding-bottom: 28px; position: relative; z-index: 1; }
  .marca { font-family: var(--titulo); font-weight: 800; font-size: 22px; text-decoration: none; }
  .ponto { color: var(--verde); }
  .hero { padding: 24px 0 0; overflow: hidden; }
  .hero-grade { max-width: 820px; }
  .hero-texto { padding-bottom: 96px; }
  .perfil { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
  .perfil .selo { margin: 0; }
  .avatar { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--verde); flex-shrink: 0; }
  h1 { font-size: clamp(38px, 5.6vw, 64px); margin-bottom: 24px; }
  .verde-claro { color: var(--verde); display: block; }
  .sub { color: rgba(255,255,255,.75); font-size: 20px; max-width: 540px; margin-bottom: 36px; }
  .escuro .gratis { color: var(--verde); font-weight: 700; font-size: 15px; letter-spacing: .02em; margin: -20px 0 32px; }
  .acoes { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
  .escuro-texto { color: var(--cinza); }
  .intro { color: var(--cinza); font-size: 20px; max-width: 680px; margin-bottom: 48px; }
  .escuro .intro, .escuro p { color: rgba(255,255,255,.78); }
  .pilares { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .pilares li { border-top: 2px solid var(--texto); padding-top: 20px; }
  .num { font-family: var(--titulo); font-weight: 700; color: var(--verde-escuro); font-size: 15px; }
  .pilares h3, .tema h3, .canal h3, .segmento h3 { font-family: var(--corpo); font-weight: 800; letter-spacing: -0.02em; }
  .pilares h3 { font-size: 22px; margin: 8px 0; }
  .pilares p, .tema p, .segmento p { color: var(--cinza); font-size: 16px; }
  .segmentos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .segmento { background: #fff; border: 1px solid var(--linha); border-radius: 20px; padding: 28px; }
  .segmento h3 { font-size: 19px; margin-bottom: 8px; }
  .fecho { margin-top: 40px; font-family: var(--titulo); font-size: 24px; font-weight: 700; }
  .historia-grade { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 64px; align-items: start; }
  .foto-historia { border-radius: 24px; aspect-ratio: 1; object-fit: cover; position: sticky; top: 32px; }
  .historia-grade .texto p { margin-bottom: 20px; }
  blockquote { margin-top: 40px; font-family: var(--titulo); font-size: clamp(24px, 3vw, 32px); line-height: 1.3; color: var(--verde); }
  .numeros { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .numero { border-left: 2px solid var(--verde); padding-left: 20px; }
  .numero strong { display: block; font-family: var(--titulo); font-size: clamp(32px, 4vw, 48px); line-height: 1.1; }
  .numero span { color: var(--cinza); }
  .marcos { list-style: none; margin-top: 56px; display: grid; gap: 12px; }
  .marcos span { font-weight: 800; margin-right: 16px; color: var(--verde-escuro); }
  .temas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .tema h3 { font-size: 20px; margin-bottom: 8px; }
  .eco-grade { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 56px; align-items: center; }
  .foto-eco { border-radius: 24px; aspect-ratio: 4/5; object-fit: cover; max-width: 380px; justify-self: end; }
  .canais { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .canal { background: #fff; border: 1px solid var(--linha); border-radius: 20px; padding: 32px; text-decoration: none; display: flex; flex-direction: column; gap: 12px; transition: border-color .2s, transform .2s; }
  .canal:hover { border-color: var(--verde); transform: translateY(-2px); }
  .canal-nome { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--cinza); }
  .canal h3 { font-size: 24px; }
  .canal p { color: var(--cinza); font-size: 16px; flex: 1; }
  .comunidade { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .comunidade p { max-width: 620px; }
  .comunidade h2 { margin-bottom: 16px; }
  .rarm { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .rarm p { color: var(--cinza); max-width: 640px; }
  .rarm h2 { margin-bottom: 16px; }
  .final { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .final h2 { margin-bottom: 16px; }
  .final > p:not(.assinatura) { max-width: 560px; margin-bottom: 32px; }
  .escuro .assinatura { margin-top: 56px; font-size: 15px; color: rgba(255,255,255,.5); }
  .em-breve { opacity: .7; }
  .breve { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--cinza); white-space: nowrap; }
  .breve.claro { color: rgba(255,255,255,.6); }
  .rodape { display: flex; justify-content: space-between; padding-top: 32px; padding-bottom: 32px; font-size: 14px; color: var(--cinza); gap: 16px; flex-wrap: wrap; }
  .rodape nav { display: flex; gap: 20px; flex-wrap: wrap; }
  .rodape a { text-decoration: none; }
  .rodape a:hover { color: var(--texto); }
  @media (max-width: 960px) {
    .segmentos, .temas { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 860px) {
    .hero-texto { padding-bottom: 72px; }
    .pilares { grid-template-columns: 1fr; gap: 28px; }
    .historia-grade, .eco-grade { grid-template-columns: 1fr; gap: 40px; }
    .foto-historia { position: static; max-width: 320px; }
    .foto-eco { justify-self: start; max-width: 320px; }
    .canais { grid-template-columns: 1fr; }
    .rarm, .comunidade { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 560px) {
    .segmentos, .numeros, .temas { grid-template-columns: 1fr; }
  }
</style>
